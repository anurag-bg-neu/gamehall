<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { title: character.name + ' - Character Details' }) %>
<body>
  <main class="container">
    <a href="/">&larr; Back to all characters</a>

    <article class="detail-card">
      <img
        src="https://api.dicebear.com/7.x/bottts/svg?seed=<%= character.avatarSeed %>"
        alt="<%= character.name %> avatar"
        class="detail-img"
      />
      <div>
        <h1><%= character.name %></h1>
        <p><strong>Game:</strong> <%= character.game %></p>
        <p><strong>Role:</strong> <%= character.role %></p>
        <p><strong>Power Rating:</strong> <%= character.power %>/100</p>
        <p><%= character.description %></p>
      </div>
    </article>
  </main>
</body>
</html>
