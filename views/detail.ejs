<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { title: character.name + ' - GameHall' }) %>
<body>
  <div class="detail-wrap">
    <a href="/" class="back-link">&larr; Back to roster</a>

    <article class="fighter-card">
      <div class="fighter-portrait">
        <img
          src="https://api.dicebear.com/7.x/adventurer/svg?seed=<%= character.avatarSeed %>&backgroundColor=1a1e26"
          alt="<%= character.name %> portrait"
        />
      </div>
      <div class="fighter-info">
        <div class="fighter-badge"><%= character.game %></div>
        <h1><%= character.name %></h1>
        <p class="fighter-role"><%= character.role %></p>

        <div class="fighter-power-row">
          <span class="fighter-power-label">POWER</span>
          <div class="power-bar-track">
            <div class="power-bar-fill" style="width: <%= character.power %>%;"></div>
          </div>
          <span class="power-bar-value"><%= character.power %></span>
        </div>

        <p class="fighter-desc"><%= character.description %></p>
      </div>
    </article>
  </div>
</body>
</html>
