<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { title: 'GameHall' }) %>
<body>
  <section class="hero">
    <div class="hero-eyebrow">PLAYER SELECT</div>
    <h1>GAMEHALL</h1>
    <p>Seven legends pulled from seven different worlds. Pick a fighter to see their full stat card.</p>
    <a href="#roster" class="hero-cta">Select Your Fighter</a>
  </section>

  <main class="roster" id="roster">
    <h2 class="roster-heading">The Roster</h2>
    <p class="roster-sub">Every character below has a dedicated stat card &mdash; click one to open it.</p>

    <div class="grid-cards">
      <% characters.forEach(function(character) { %>
        <a class="card" href="/characters/<%= character.slug %>">
          <div class="card-img-wrap">
            <img
              class="card-img"
              src="https://api.dicebear.com/7.x/adventurer/svg?seed=<%= character.avatarSeed %>&backgroundColor=1a1e26"
              alt="<%= character.name %> portrait"
            />
            <div class="card-nameplate">
              <h3><%= character.name %></h3>
            </div>
          </div>
          <div class="card-meta">
            <div><span class="game"><%= character.game %></span> &middot; <%= character.role %></div>
            <div class="power-bar">
              <div class="power-bar-track">
                <div class="power-bar-fill" style="width: <%= character.power %>%;"></div>
              </div>
              <span class="power-bar-value"><%= character.power %></span>
            </div>
          </div>
        </a>
      <% }); %>
    </div>
  </main>
</body>
</html>
